---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import logo from '../assets/logo-mark.svg?raw';
import type { Locale } from '../i18n/config';
import { pathFor, type PageId } from '../i18n/routes';
import { getDictionary } from '../i18n/translate';
import { GITHUB_ORG } from '../project';

interface Props {
  locale: Locale;
  page: PageId | null;
}

const { locale, page } = Astro.props;
const t = getDictionary(locale);
const home = pathFor('home', locale);
const docs = locale === 'de' ? '/de/docs/' : '/docs/';
const anchor = (id: string) => (page === 'home' ? `#${id}` : `${home}#${id}`);
const links = [
  { href: anchor('how'), label: t.common.nav.howItWorks },
  { href: anchor('features'), label: t.common.nav.features },
  { href: anchor('runners'), label: t.common.nav.runners },
  { href: anchor('trust'), label: t.common.nav.trust },
  { href: anchor('open-source'), label: t.common.nav.openSource },
];
---

<header class="site-header">
  <div class="bar container">
    <a class="brand" href={home} aria-label={t.common.siteName}>
      <span class="mark" set:html={logo} />
      <span class="word" aria-hidden="true">
        <span class="name">open<span class="blue">agentix</span></span>
        <span class="sub">{t.common.superIntelligence}</span>
      </span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t.common.nav.label} data-open="false">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={docs}>{t.common.nav.docs}</a></li>
      </ul>
      <div class="nav-extra">
        <LangSwitch locale={locale} page={page} />
      </div>
    </nav>

    <div class="actions">
      <div class="lang-desktop"><LangSwitch locale={locale} page={page} compact /></div>
      <button class="icon-btn" type="button" data-theme-toggle aria-pressed="false" aria-label={t.common.theme.toggle}>
        <Icon name="sun" class="i-sun" size={18} />
        <Icon name="moon" class="i-moon" size={18} />
      </button>
      <a class="icon-btn" href={GITHUB_ORG} aria-label={t.common.nav.github}>
        <Icon name="github" size={18} />
      </a>
      <a class="btn btn--primary docs-btn" href={docs}>{t.common.nav.docs}</a>
      <button class="icon-btn menu-btn" type="button" data-menu-button aria-controls="site-nav" aria-expanded="false" aria-label={t.common.nav.menu}>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.125rem;
  }

  .mark :global(svg) {
    width: 30px;
    height: 30px;
  }

  .word {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .blue {
    color: var(--brand-blue);
  }

  /* Understated tagline under the name: small, muted purple, never louder than the nav. */
  .sub {
    margin-top: 0.15rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--brand-muted-purple);
  }

  .nav {
    flex: 1;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav-extra {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--text);
    background: rgb(127 127 127 / 0.12);
  }

  :global(:root[data-theme='light']) .i-moon,
  :global(:root:not([data-theme='light'])) .i-sun {
    display: none;
  }

  .docs-btn {
    min-height: 2.4rem;
    padding: 0.4rem 1rem;
    font-size: 0.9375rem;
    margin-left: 0.35rem;
  }

  .menu-btn {
    display: none;
  }

  @media (max-width: 960px) {
    .nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      padding: 1rem var(--gutter) 1.5rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      display: none;
    }

    .nav[data-open='true'] {
      display: block;
    }

    .nav ul {
      flex-direction: column;
    }

    .nav a {
      font-size: 1.125rem;
      padding: 0.75rem 0;
    }

    .nav-extra {
      display: block;
      margin-top: 1rem;
    }

    .lang-desktop,
    .docs-btn {
      display: none;
    }

    .menu-btn {
      display: inline-grid;
    }
  }
</style>
