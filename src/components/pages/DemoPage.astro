---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/config';
import { getDictionary } from '../../i18n/translate';
import { demoHost } from '../../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = getDictionary(locale).pages.demo;
const demo = demoHost;
---

<Base locale={locale} page="demo" title={d.metaTitle} description={d.description}>
  <section class="container demo">
    <p class="pill">{d.eyebrow}</p>
    <h1 class="headline">{d.heading}</h1>
    <p class="lead">{d.lead}</p>

    <h2>{d.stepsTitle}</h2>
    <ol class="steps">
      {
        d.steps.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="note">{d.note}</p>
    <div class="actions">
      <a class="btn btn--primary" href={demo}>{d.open} <Icon name="arrow" size={16} /></a>
      <a class="btn btn--ghost" href="/docs/start/getting-started/">{d.cta}</a>
    </div>
  </section>
</Base>

<style>
  .demo {
    max-width: 52rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .pill {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px dashed var(--warn);
    color: var(--warn);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .lead {
    margin-top: 1.25rem;
  }

  h2 {
    margin-top: 3rem;
    font-size: 1.375rem;
    font-weight: 650;
  }

  .steps {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .steps li {
    padding: 1.25rem;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgb(139 92 246 / 0.16);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .steps h3 {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
  }

  .steps p {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .note {
    margin: 2rem 0 1.5rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
