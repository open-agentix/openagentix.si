---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n/config';
import { getDictionary } from '../../i18n/translate';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = getDictionary(locale).pages.demo;
// Illustrative command for the planned demo; the endpoint does not exist yet.
const curl = `curl -X POST https://demo.openagentix.si/v1/events/webhook/demo \\
  -H 'Content-Type: application/json' \\
  -d '{"type":"image.pushed","image":"registry.example/app:1.4.2"}'`;
---

<Base locale={locale} page="demo" title={d.metaTitle} description={d.description}>
  <section class="container demo">
    <p class="pill">{d.eyebrow}</p>
    <h1 class="headline">{d.heading}</h1>
    <p class="lead">{d.lead}</p>

    <h2>{d.stepsTitle}</h2>
    <ol class="steps">
      {
        d.steps.map((s, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>

    <figure class="code">
      <figcaption>{d.curlLabel}</figcaption>
      <pre><code>{curl}</code></pre>
    </figure>
    <p class="muted"><Icon name="mail" size={16} /> {d.mail}</p>
    <p class="note">{d.note}</p>
    <a class="btn btn--primary" href="/docs/start/getting-started/">{d.cta} <Icon name="arrow" size={16} /></a>
  </section>
</Base>

<style>
  .demo {
    max-width: 52rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .pill {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1px dashed var(--warn);
    color: var(--warn);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .lead {
    margin-top: 1.25rem;
  }

  h2 {
    margin-top: 3rem;
    font-size: 1.375rem;
    font-weight: 650;
  }

  .steps {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .steps li {
    padding: 1.25rem;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgb(139 92 246 / 0.16);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .steps h3 {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
  }

  .steps p {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .code {
    margin: 2.5rem 0 0;
  }

  figcaption {
    font-size: 0.8125rem;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  pre {
    margin: 0;
    padding: 1.25rem;
    border-radius: var(--radius-m);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .muted {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
  }

  .note {
    margin: 1.5rem 0 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
