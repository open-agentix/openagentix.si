---
// Pinned scroll scene: steps scroll past while the stage stays in view. The active step is
// mirrored to `data-step` on the section by src/scripts/scroll-fx.ts; stages style themselves with
// `[data-step='n']` selectors. Without JS the first step stays active and all text remains readable.
interface Step {
  label: string;
  title: string;
  body: string;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  steps: Step[];
  progress: string;
}

const { id, eyebrow, title, lead, steps, progress } = Astro.props;
const first = progress.replace('{current}', '1').replace('{total}', String(steps.length));
---

<section class="scene section" id={id} data-scene data-step="0" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="headline">{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </header>
    <div class="layout">
      <div class="stage-wrap">
        <div class="stage" aria-hidden="true">
          <slot name="stage" />
        </div>
        <p class="progress" data-scene-progress data-template={progress} aria-hidden="true">{first}</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class:list={['step', { 'is-active': i === 0 }]} data-scene-step>
              <p class="step-label">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                {s.label}
              </p>
              <h3>{s.title}</h3>
              <p class="body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .steps {
    grid-column: 1;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0 0 12vh;
  }

  .stage-wrap {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    height: calc(100svh - var(--header-h) - 4rem);
    display: flex;
    flex-direction: column;
  }

  .stage {
    position: relative;
    flex: 1;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 80% at 70% 0%, var(--glow-a), transparent 60%),
      var(--bg-soft);
    border: 1px solid var(--border);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  .progress {
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Inactive steps keep full text contrast; the active one gets an accent bar and moves in. */
  .step {
    position: relative;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 1.5rem;
  }

  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 9rem;
    margin-top: -4.5rem;
    border-radius: 3px;
    background: var(--gradient-accent);
    transform: scaleY(0.15);
    opacity: 0.35;
    transition:
      transform 0.7s var(--ease-out),
      opacity 0.7s var(--ease-out);
  }

  .step > * {
    transition: transform 0.7s var(--ease-out);
  }

  .step.is-active::before {
    transform: scaleY(1);
    opacity: 1;
  }

  .step.is-active > * {
    transform: translate3d(0.5rem, 0, 0);
  }

  .step-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .num {
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  .step h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  .step .body {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 32rem;
  }

  @media (max-width: 759.98px) {
    .layout {
      display: block;
    }

    .stage-wrap {
      top: var(--header-h);
      padding-top: 0.5rem;
      height: calc(46svh + 0.5rem);
      z-index: 2;
      background: var(--bg);
      padding-bottom: 0.5rem;
    }

    .steps {
      padding: 4vh 0 20vh;
    }

    .step {
      min-height: 55vh;
      justify-content: flex-end;
      padding-bottom: 6vh;
    }
  }

</style>
