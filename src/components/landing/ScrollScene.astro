---
// Pinned scroll scene: steps scroll past while the stage stays in view. The active step is
// mirrored to `data-step` on the section by src/scripts/scroll-fx.ts; stages style themselves with
// `[data-step='n']` selectors. Without JS the first step stays active and all text remains readable.
interface Step {
  label: string;
  title: string;
  body: string;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  steps: Step[];
  progress: string;
}

const { id, eyebrow, title, lead, steps, progress } = Astro.props;
const first = progress.replace('{current}', '1').replace('{total}', String(steps.length));
---

<section class="scene section" id={id} data-scene data-step="0" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="headline">{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </header>
    <div class="layout">
      <div class="stage-wrap" data-scene-stage>
        <div class="stage" aria-hidden="true">
          <slot name="stage" />
        </div>
        <p class="dots" aria-hidden="true">
          {steps.map(() => <span class="dot" />)}
        </p>
        <p class="progress" data-scene-progress data-template={progress} aria-hidden="true">{first}</p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class:list={['step', { 'is-active': i === 0 }]} data-scene-step>
              <p class="step-label">
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                {s.label}
              </p>
              <h3>{s.title}</h3>
              <p class="body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .steps {
    grid-column: 1;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0 0 12vh;
  }

  .stage-wrap {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    height: calc(100svh - var(--header-h) - 4rem);
    display: flex;
    flex-direction: column;
  }

  .stage {
    position: relative;
    flex: 1;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 80% at 70% 0%, var(--glow-a), transparent 60%),
      var(--bg-soft);
    border: 1px solid var(--border);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  /* Progress dots are a phone-only affordance (see the media query below). */
  .dots {
    display: none;
  }

  .progress {
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Inactive steps keep full text contrast; the active one gets an accent bar and moves in. */
  .step {
    position: relative;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 1.5rem;
  }

  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 9rem;
    margin-top: -4.5rem;
    border-radius: 3px;
    background: var(--gradient-accent);
    transform: scaleY(0.15);
    opacity: 0.35;
    transition:
      transform 0.7s var(--ease-out),
      opacity 0.7s var(--ease-out);
  }

  .step > * {
    transition: transform 0.7s var(--ease-out);
  }

  .step.is-active::before {
    transform: scaleY(1);
    opacity: 1;
  }

  .step.is-active > * {
    transform: translate3d(0.5rem, 0, 0);
  }

  .step-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .num {
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  .step h3 {
    margin-top: 0.9rem;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  .step .body {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 32rem;
  }

  /* Short landscape screens keep the two columns but show the same fixed-ratio window as phones. */
  @media (min-width: 820.02px) and (max-height: 520px) and (orientation: landscape) {
    .stage-wrap {
      top: calc(var(--header-h) + 0.75rem);
      height: auto;
    }

    .stage {
      flex: none;
      aspect-ratio: 440 / 372;
      height: calc(100svh - var(--header-h) - 4.5rem);
      width: auto;
      max-width: 100%;
      margin-inline: auto;
    }
  }

  /*
   * Phones: a compact sticky figure with the current step's text directly beneath it. The stage keeps
   * the aspect ratio of its content (no clipping, no viewport-height maths), capped to ~44svh; svh
   * is used so the browser toolbars sliding in and out never resize it.
   */
  @media (max-width: 820px) {
    .layout {
      display: block;
    }

    .stage-wrap {
      top: var(--header-h);
      height: auto;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      row-gap: 0.5rem;
      padding: 0.5rem 0;
      background: var(--bg);
    }

    /* A soft edge so scrolling text fades under the stage instead of being cut off. */
    .stage-wrap::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 0.875rem;
      background: linear-gradient(var(--bg), transparent);
      pointer-events: none;
    }

    .stage {
      grid-column: 1 / -1;
      flex: none;
      aspect-ratio: 440 / 372;
      width: min(100%, calc(44svh * 440 / 372));
      margin-inline: auto;
    }

    .dots {
      display: flex;
      gap: 0.65rem;
      margin: 0;
      padding-left: 0.4rem;
    }

    .dot {
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      background: var(--border-strong);
      transition:
        transform 0.4s var(--ease-out),
        background-color 0.4s var(--ease-out);
    }

    .scene[data-step='0'] .dot:nth-child(1),
    .scene[data-step='1'] .dot:nth-child(2),
    .scene[data-step='2'] .dot:nth-child(3),
    .scene[data-step='3'] .dot:nth-child(4),
    .scene[data-step='4'] .dot:nth-child(5) {
      background: var(--accent);
      transform: scaleX(3);
    }

    .progress {
      margin: 0;
      font-size: 0.75rem;
    }

    .steps {
      padding: 0 0 14svh;
    }

    /* Each step owns about half a screen, text on top so it sits right under the figure. */
    .step {
      min-height: 52svh;
      justify-content: flex-start;
      padding: 0.75rem 0 0 1.1rem;
    }

    /* Inactive steps keep full text contrast; only the accent bar marks the current one. */
    .step::before {
      top: 0.75rem;
      height: 6rem;
      margin-top: 0;
    }

    .step > *,
    .step.is-active > * {
      transform: none;
      transition: none;
    }

    .step h3 {
      margin-top: 0.5rem;
      font-size: clamp(1.3rem, 5.6vw, 1.75rem);
    }

    .step .body {
      margin-top: 0.6rem;
      font-size: 1rem;
      line-height: 1.55;
    }
  }

  @media (max-width: 820px) and (prefers-reduced-motion: reduce) {
    .step::before,
    .dot {
      transition: none;
    }
  }
</style>
